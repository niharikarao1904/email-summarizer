{
  "manifest_version": 3,
  "name": "Smart Email Summarizer",
  "version": "1.0.0",
  "description": "Summarize long emails and articles using AI",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}